package console

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/justenwalker/kevin/internal/browser"
	"github.com/justenwalker/kevin/internal/proxy"
	"github.com/justenwalker/kevin/internal/session"
)

// Page is the whole console. It renders the state that the server holds now,
// then opens one event stream that keeps every region up to date.
templ Page(v View) {
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>kevin: { v.Project }</title>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/hx-sse.min.js"></script>
			@styles()
			@scripts()
		</head>
		<body>
			<header>
				<h1>kevin <span class="proj">· { v.Project }</span></h1>
				<div class="header-chips">
					<span class="chip"><b>proxy</b><code>{ v.ProxyAddr }</code><button type="button" class="copy-btn" data-copy={ v.ProxyAddr } onclick="copyAddr(this)" title="copy">⧉</button></span>
					<span class="chip"><b>mcp</b><code>{ v.McpURL }</code><button type="button" class="copy-btn" data-copy={ v.McpURL } onclick="copyAddr(this)" title="copy">⧉</button></span>
					<span class="chip"><b>net</b><code>{ v.Network }</code></span>
				</div>
			</header>
			<!-- One connection feeds every region. Each message is an out of
			     band fragment that names its own target. -->
			<div hx-sse:connect="/events" hx-swap="none" hidden></div>
			<div class="layout">
				<aside id="sidebar">
					<h2>Steps</h2>
					<svg id="dep-lines" aria-hidden="true">
						<defs>
							<marker id="dep-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
								<path d="M0,0 L10,5 L0,10 z" style="fill:context-stroke"></path>
							</marker>
						</defs>
						<g id="dep-edges"></g>
					</svg>
					<ul id="steps">
						for _, s := range v.Steps {
							if s.Group == "" {
								if s.IsGroup {
									@GroupItem(s, stepsByGroup(v.Steps)[s.Name])
								} else {
									@StepItem(s)
								}
							}
						}
					</ul>
				</aside>
				<main>
					<div class="tabbar">
						<label for="tab-services">Services</label>
						<label for="tab-logs">Logs</label>
						<label for="tab-proxy">Proxy</label>
						<label for="tab-mcp">MCP</label>
					</div>
					<input type="radio" name="maintab" id="tab-services" class="tabinput" checked/>
					<section id="panel-services" class="panel">
						<div id="cards" class="cards">
							for _, s := range v.Steps {
								@StepCard(s)
							}
							<p class="empty">No services exposed yet - a step shows up here once it publishes a route or address.</p>
						</div>
					</section>
					<input type="radio" name="maintab" id="tab-logs" class="tabinput"/>
					<section id="panel-logs" class="panel">
						<div class="logs-layout">
							<!-- Labels live here; their radios and panels stay as
							     untouched pairs below in .log-panels, so the existing
							     ":checked + .logpanel" rule still works. -->
							<div class="log-steps">
								<label for="logtab-all">All</label>
								for _, s := range v.Steps {
									<label for={ "logtab-" + s.Name }>
										if s.State == Running {
											<span class="log-live-dot" title="streaming"></span>
										}
										{ s.Name }
									</label>
								}
							</div>
							<div class="log-panels">
								<input type="radio" name="logtab" id="logtab-all" class="logtabinput" checked/>
								<div id="log-all" class="logpanel scroll">
									for _, l := range v.Logs {
										@LogLine(l)
									}
								</div>
								for _, s := range v.Steps {
									<input type="radio" name="logtab" id={ "logtab-" + s.Name } class="logtabinput"/>
									<div id={ "log-" + s.Name } class="logpanel scroll">
										for _, l := range v.StepLogs[s.Name] {
											@LogLine(l)
										}
									</div>
								}
							</div>
						</div>
					</section>
					<input type="radio" name="maintab" id="tab-proxy" class="tabinput"/>
					<section id="panel-proxy" class="panel">
						@proxySetup(v)
						<table>
							<thead>
								<tr><th>status</th><th>method</th><th>host</th><th>path</th><th>ms</th></tr>
							</thead>
							<tbody id="traffic">
								for _, r := range v.Requests {
									@TrafficRow(r)
								}
							</tbody>
						</table>
					</section>
					<input type="radio" name="maintab" id="tab-mcp" class="tabinput"/>
					<section id="panel-mcp" class="panel">
						@mcpSetup(v)
					</section>
				</main>
			</div>
		</body>
	</html>
}

// proxySetup shows how to point a shell or a browser at the proxy: the PAC
// URL and the http_proxy/https_proxy export line every tool understands,
// plus instructions targeted at the browser viewing the page (env vars
// don't configure a browser's own proxy settings).
templ proxySetup(v View) {
	<div class="card exposed">
		<h3>Using the proxy</h3>
		<div class="detail">
			<span class="detail-label">shell</span>
			<div class="detail-value">
				<code>{ exportLine(v.ProxyAddr) }</code>
				<button type="button" class="copy-btn" data-copy={ exportLine(v.ProxyAddr) } onclick="copyAddr(this)" title="copy">⧉</button>
			</div>
		</div>
		<div class="detail">
			<span class="detail-label">PAC URL</span>
			<div class="detail-value">
				<code>{ pacURL(v.ProxyAddr) }</code>
				<button type="button" class="copy-btn" data-copy={ pacURL(v.ProxyAddr) } onclick="copyAddr(this)" title="copy">⧉</button>
			</div>
		</div>
		<p class="hint">
			switch v.Browser {
				case browser.Firefox:
					Firefox keeps its own proxy settings, separate from the OS: paste the PAC URL into Settings → General → Network Settings → Automatic proxy configuration URL. Firefox also keeps its own certificate store - run <code>kevin setup</code> to trust the CA there. Or use a <a href={ firefoxAddonsURL } target="_blank" rel="noopener noreferrer">proxy extension</a> instead.
				case browser.Chrome:
					Chrome follows the OS's network proxy settings: point them at the PAC URL, or launch Chrome with <code>--proxy-pac-url={ pacURL(v.ProxyAddr) }</code>, which applies only to that one launch. Or use a <a href={ chromeWebStoreURL } target="_blank" rel="noopener noreferrer">proxy extension</a> instead.
				case browser.Safari:
					Safari follows macOS's network proxy settings (System Settings → Network → Details → Proxies): point them at the PAC URL.
				default:
					Point your browser's proxy settings at the PAC URL above.
			}
		</p>
	</div>
}

// exportLine is the http_proxy/https_proxy export line for proxyAddr, the
// form every shell and most CLI tools understand.
func exportLine(proxyAddr string) string {
	return fmt.Sprintf("export HTTP_PROXY=http://%s HTTPS_PROXY=http://%s", proxyAddr, proxyAddr)
}

// mcpSetup shows how to register the MCP server with a coding agent: the
// Claude Code CLI command, and the raw URL for any other MCP client that
// speaks Streamable HTTP.
templ mcpSetup(v View) {
	<div class="card exposed">
		<h3>Using the MCP server</h3>
		<div class="detail">
			<span class="detail-label">Claude Code</span>
			<div class="detail-value">
				<code>{ claudeMcpAddCmd(v.McpURL) }</code>
				<button type="button" class="copy-btn" data-copy={ claudeMcpAddCmd(v.McpURL) } onclick="copyAddr(this)" title="copy">⧉</button>
			</div>
		</div>
		<div class="detail">
			<span class="detail-label">URL</span>
			<div class="detail-value">
				<code>{ v.McpURL }</code>
				<button type="button" class="copy-btn" data-copy={ v.McpURL } onclick="copyAddr(this)" title="copy">⧉</button>
			</div>
		</div>
		<p class="hint">
			Any MCP client that speaks Streamable HTTP can connect at the URL above. It offers five tools: <code>list_steps</code>, <code>get_step</code>, <code>rerun_step</code>, <code>export_step</code>, <code>get_proxy_info</code>.
		</p>
	</div>
}

// claudeMcpAddCmd is the Claude Code CLI command that registers the MCP
// server at mcpURL.
func claudeMcpAddCmd(mcpURL string) string {
	return fmt.Sprintf("claude mcp add --transport http kevin %s", mcpURL)
}

// chromeWebStoreURL and firefoxAddonsURL point at a search for proxy
// extensions, offered as an alternative to PAC/OS proxy configuration.
const (
	chromeWebStoreURL = "https://chromewebstore.google.com/search/proxy"
	firefoxAddonsURL  = "https://addons.mozilla.org/en-US/firefox/search/?q=proxy"
)

// pacURL is the proxy's auto-config URL for proxyAddr - what a browser
// (which doesn't read http_proxy/https_proxy) needs instead.
func pacURL(proxyAddr string) string {
	return "http://" + proxyAddr + proxy.PACPath
}

// stepsByGroup groups steps by their own Group field, preserving each
// group's member order.
func stepsByGroup(steps []Step) map[string][]Step {
	m := make(map[string][]Step)
	for _, s := range steps {
		if s.Group != "" {
			m[s.Group] = append(m[s.Group], s)
		}
	}
	return m
}

// sameScopeNeeds returns the entries of needs the sidebar draws a line for -
// crossScopeNeeds excluded.
func sameScopeNeeds(needs []string) []string {
	out := make([]string, 0, len(needs))
	for _, n := range needs {
		if !strings.HasPrefix(n, session.SetupPrefix) {
			out = append(out, n)
		}
	}
	return out
}

// crossScopeNeeds returns the setup-scope step names needs reads via
// ${setup.<name>.out.<key>}, unprefixed. Drawing one of these as a sidebar
// line would draw an edge into a console the current scope never renders -
// every step reading the same setup step gets a badge instead, so a setup
// step with many readers doesn't converge into one cluttered hub.
func crossScopeNeeds(needs []string) []string {
	var out []string
	for _, n := range needs {
		if name, ok := strings.CutPrefix(n, session.SetupPrefix); ok {
			out = append(out, name)
		}
	}
	return out
}

// kindIcon returns the icon that marks a step's kind, or "" for none.
func kindIcon(kind string) string {
	switch kind {
	case "resource":
		return "📦"
	case "action":
		return "⚡"
	case "probe":
		return "🔍"
	default:
		return ""
	}
}

// pluginIcon marks which plugin backs a step: its own icon when it gave
// one, alt text carrying the plugin name. builtin never gets a puzzle
// piece - that placeholder means "third-party plugin, no icon given";
// builtin isn't a plugin missing an icon, it's the thing everything
// else is being distinguished from.
templ pluginIcon(s Step) {
	if len(s.Icon) > 0 {
		<img class="plugin-icon" src={ iconDataURI(s.Icon) } alt={ s.Provider }/>
	} else if s.Provider != "builtin" {
		<span class="plugin-icon plugin-icon-default" title={ s.Provider }>🧩</span>
	}
}

// StepItem is one step in the sidebar. It replaces itself out of band, thus
// one message updates one entry. A compact step (a gate for some other
// resource/action - a probe, or builtin:route) collapses to a single muted
// line instead of the full card, so the resource/action steps that do the
// real work keep the visual weight.
templ StepItem(s Step) {
	if s.Compact {
		@compactStepItem(s)
	} else {
		@fullStepItem(s)
	}
}

templ fullStepItem(s Step) {
	<li id={ "step-" + s.Name } hx-swap-oob="true" class={ "state-" + string(s.State) } data-needs={ strings.Join(sameScopeNeeds(s.Needs), ",") }>
		<span class="name">
			@pluginIcon(s)
			{ s.Label }
		</span>
		<span class="status-line">
			if s.Kind != "" {
				<span class={ "kind-text", "kind-" + s.Kind }>{ kindIcon(s.Kind) } { s.Kind }</span>
				<span class="dot">·</span>
			}
			<span class="status-text">{ string(s.State) }</span>
			@idempotentBadge(s)
			@crossScopeBadge(s)
		</span>
		if s.State == Running || s.State == Removing {
			@progressBar(s.Name, s.Progress)
		}
		if s.Message != "" {
			<span class="msg">{ s.Message }</span>
		}
		@rerunActions(s)
	</li>
}

// progressBar is a running (or removing) step's progress bar: a fixed
// "bar-<name>" id (the target [oobProgress] patches) wrapping a fill sized
// to progress, hidden via the bar-hidden class when progress is 0.
templ progressBar(name string, progress float64) {
	<div id={ "bar-" + name } class={ "bar", templ.KV("bar-hidden", progress <= 0) }>
		<div class="bar-fill" style={ fmt.Sprintf("width:%.0f%%", progress*100) }></div>
	</div>
}

// oobProgress replaces one step's progress bar out of band, targeted at
// its "bar-<name>" id - the rest of the step's sidebar entry is untouched.
templ oobProgress(p session.StepProgress) {
	<hx-partial hx-target={ "#bar-" + p.Name } hx-swap="outerHTML">
		@progressBar(p.Name, p.Progress)
	</hx-partial>
}

templ compactStepItem(s Step) {
	<li id={ "step-" + s.Name } hx-swap-oob="true" class={ "compact", "state-" + string(s.State) } data-needs={ strings.Join(sameScopeNeeds(s.Needs), ",") }>
		<span class="name">
			@pluginIcon(s)
			{ s.Label }
		</span>
		@crossScopeBadge(s)
		<span class="status-text">{ string(s.State) }</span>
		if s.Message != "" {
			<span class="msg">{ s.Message }</span>
		}
		@rerunActions(s)
	</li>
}

// GroupItem is a step group's own row: a checkbox+label toggle (the same
// technique the tab bar uses, no JS needed for the show/hide itself) with
// its members nested inside, collapsed by default. Unlike a plain step's
// row, this outer <li> is never itself replaced by an OOB update - only
// its header (see groupHeader) - so a later state change never re-collapses
// an already-expanded group by replacing its checkbox out from under it.
templ GroupItem(s Step, members []Step) {
	<li id={ "step-" + s.Name } class="group" data-needs={ strings.Join(sameScopeNeeds(s.Needs), ",") }>
		<input type="checkbox" id={ "group-toggle-" + s.Name } class="group-toggle" onchange="drawDepLines()"/>
		<label for={ "group-toggle-" + s.Name } class="group-header">
			@groupHeader(s)
			@crossScopeBadge(s)
		</label>
		<ul class="group-members">
			for _, m := range members {
				@StepItem(m)
			}
		</ul>
	</li>
}

// groupHeader is a group's own state row - the part of GroupItem an OOB
// update replaces on its own, leaving the toggle checkbox (and so whether
// the group reads expanded or collapsed) untouched.
templ groupHeader(s Step) {
	<span id={ "group-header-" + s.Name } hx-swap-oob="true" class={ "group-header-content", "state-" + string(s.State) }>
		<span class="disclosure">▸</span>
		<span class="name">{ s.Label }</span>
		<span class="pill">{ string(s.State) }</span>
		if s.Message != "" {
			<span class="msg">{ s.Message }</span>
		}
	</span>
}

// idempotentBadge marks a step whose type is safe to call Up on again - it
// may be swept into a cascading rerun of a step it depends on, not just
// rerun directly.
templ idempotentBadge(s Step) {
	if s.Idempotent {
		<span class="badge-idempotent" title="idempotent - safe to include in a cascading rerun of a step this depends on">♻</span>
	}
}

// crossScopeBadge marks a step that reads one or more setup-scope steps'
// outputs, naming them in the tooltip instead of drawing a line for each.
templ crossScopeBadge(s Step) {
	if names := crossScopeNeeds(s.Needs); len(names) > 0 {
		<span class="badge-cross-scope" title={ "reads setup: " + strings.Join(names, ", ") }>↗ setup</span>
	}
}

// rerunActions is a step's rerun controls, shown in the sidebar so they
// stay visible even for a step with no exposed details. A Failed step gets
// one plain button that always cascades - it has nothing of its own to
// preserve, only skipped dependents to fill in, so there's no choice to
// offer. A Ready step gets a split button: the primary action reruns just
// itself, and a caret (a hidden checkbox + label, the same technique
// group-toggle already uses - no JS needed) opens a small menu for the
// cascade option. Any other state has nothing to rerun yet.
templ rerunActions(s Step) {
	if s.State == Failed {
		<div class="rerun-actions">
			<div class="split cascade-only">
				<button type="button" class="split-btn" hx-post={ "/steps/" + s.Name + "/rerun" } hx-vals="{&#34;cascade&#34;:&#34;true&#34;}" hx-swap="none" title="rerun - also retries the steps this failure skipped">⇶ rerun + skipped</button>
			</div>
		</div>
	} else if s.State == Ready {
		<div class="rerun-actions">
			<div class="split">
				<div class="split-controls">
					<button type="button" class="split-btn" hx-post={ "/steps/" + s.Name + "/rerun" } hx-vals="{&#34;cascade&#34;:&#34;false&#34;}" hx-swap="none" title="rerun just this step">↻ rerun</button>
					<label for={ "rerun-menu-" + s.Name } class="split-caret" title="more rerun options">⌄</label>
				</div>
				<!-- Outside .split-controls, as .rerun-menu's own sibling -
				     "overflow: hidden" clips only the button pair, and the
				     ":checked ~ .rerun-menu" rule below needs them to share
				     one parent; the label still reaches this input by id,
				     position doesn't matter for that. -->
				<input type="checkbox" id={ "rerun-menu-" + s.Name } class="rerun-menu-toggle"/>
				<div class="rerun-menu">
					<button type="button" hx-post={ "/steps/" + s.Name + "/rerun" } hx-vals="{&#34;cascade&#34;:&#34;false&#34;}" hx-swap="none">↻ just this step</button>
					<button type="button" class="cascade" hx-post={ "/steps/" + s.Name + "/rerun" } hx-vals="{&#34;cascade&#34;:&#34;true&#34;}" hx-swap="none">⇶ + idempotent deps</button>
				</div>
			</div>
		</div>
	}
}

// StepCard is one step's card in the Services tab. A step with no route yet
// still gets a card - the "exposed" class just keeps it hidden until one
// exists - so a later out of band update always has a target to land on.
templ StepCard(s Step) {
	<div id={ "card-" + s.Name } hx-swap-oob="true" class={ "card", templ.KV("exposed", len(s.Details) > 0) }>
		<h3>
			@pluginIcon(s)
			{ s.Label }
		</h3>
		if s.Kind != "" {
			<span class={ "pill", "kind-" + s.Kind }>{ kindIcon(s.Kind) } { s.Kind }</span>
		}
		@idempotentBadge(s)
		<span class="pill">{ string(s.State) }</span>
		for _, d := range s.Details {
			<div class="detail">
				if d.Label != "" {
					<span class="detail-label">{ d.Label }</span>
				}
				<div class="detail-value">
					if d.Sensitive {
						<code class="detail-sensitive" title="sensitive value, hidden">••••••••</code>
					} else if d.Href != "" {
						<a href={ templ.URL(d.Href) } target="_blank" rel="noreferrer" title={ d.Value }>{ d.Value }</a>
					} else {
						<code title={ d.Value }>{ d.Value }</code>
					}
					if d.Copyable {
						<button type="button" class="copy-btn" data-copy={ d.Value } onclick="copyAddr(this)" title="copy">⧉</button>
					}
				</div>
			</div>
		}
	</div>
}

// StepUpdate is everything that changes about a step: its sidebar entry and
// its card. Every mutator publishes this, one call per event, so the two
// regions never drift out of sync. A group's sidebar entry is its header
// alone (see groupHeader) - its outer row is never replaced whole.
templ StepUpdate(s Step) {
	if s.IsGroup {
		@groupHeader(s)
	} else {
		@StepItem(s)
	}
	@StepCard(s)
}

// LogLine is one line from a step.
templ LogLine(l Line) {
	<div class={ "line", "stream-" + l.Stream }>
		<span class="step">{ l.Step }</span>
		<span class="text">{ l.Text }</span>
	</div>
}

// TrafficRow is one request that passed through the proxy.
templ TrafficRow(r Request) {
	<tr class={ statusClass(r.Status), routedClass(r.Routed), templ.KV("denied", r.Denied) }>
		<td>
			if r.Status > 0 {
				{ strconv.Itoa(r.Status) }
			} else {
				{ "-" }
			}
		</td>
		<td>{ r.Method }</td>
		<td>{ r.Host }</td>
		<td class="path">{ r.Path }</td>
		<td>{ strconv.FormatInt(r.Millis, 10) }</td>
	</tr>
}

// oobLog wraps a line so that it appends to the "All" log panel.
templ oobLog(l Line) {
	<hx-partial hx-target="#log-all" hx-swap="beforeend">
		@LogLine(l)
	</hx-partial>
}

// oobStepLog wraps a line so that it appends to that step's own log panel.
templ oobStepLog(l Line) {
	<hx-partial hx-target={ "#log-" + l.Step } hx-swap="beforeend">
		@LogLine(l)
	</hx-partial>
}

// oobTraffic wraps a request so that it goes to the top of the table.
templ oobTraffic(r Request) {
	<hx-partial hx-target="#traffic" hx-swap="afterbegin">
		@TrafficRow(r)
	</hx-partial>
}

templ styles() {
	<style>
		:root {
			color-scheme: light dark;
			--bg: #fff; --fg: #111; --muted: #666; --line: #e3e3e3; --pill: #eee;
			--ok: #1a7f37; --warn: #9a6700; --err: #cf222e; --run: #0969da;
			--k-resource: #6639ba; --k-probe: #0f7b6c;
			/* Spacing scale for repeated margin/padding/gap values. A
			   one-off size (a fixed icon box, a card's max-width) stays
			   a literal - no reuse to name. */
			--sp-1: .15rem; --sp-2: .2rem; --sp-3: .3rem; --sp-4: .4rem;
			--sp-5: .5rem; --sp-6: .6rem; --sp-7: .75rem; --sp-8: 1rem; --sp-9: 1.5rem;
			/* Type scale: same idea for font-size. */
			--text-2xs: .7rem; --text-xs: .75rem; --text-sm: .8rem; --text-md: .85rem;
		}
		@media (prefers-color-scheme: dark) {
			:root {
				--bg: #0d1117; --fg: #e6edf3; --muted: #8b949e; --line: #30363d; --pill: #21262d;
				--ok: #3fb950; --warn: #d29922; --err: #f85149; --run: #58a6ff;
				--k-resource: #a371f7; --k-probe: #39c5bf;
			}
		}
		* { box-sizing: border-box; }
		body {
			margin: 0; padding: var(--sp-9);
			background: var(--bg); color: var(--fg);
			font: 14px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
		}
		h1 { font-size: 1.3rem; margin: 0 0 var(--sp-4); letter-spacing: .02em; }
		h1 .proj { color: var(--muted); font-weight: 400; }
		h2 { font-size: var(--text-sm); text-transform: uppercase; letter-spacing: .08em;
		     color: var(--muted); margin: 0 0 var(--sp-7); font-weight: 600; }
		.header-chips { display: flex; gap: var(--sp-4); flex-wrap: wrap; }
		.header-chips .chip {
			display: inline-flex; align-items: center; gap: var(--sp-2);
			border: 1px solid var(--line); border-radius: 999px; padding: var(--sp-1) var(--sp-4);
			font-size: var(--text-2xs); color: var(--muted);
		}
		.header-chips .chip b { color: var(--fg); font-weight: 600; }
		table { width: 100%; border-collapse: collapse; }
		th { text-align: left; font-weight: 600; color: var(--muted);
		     font-size: var(--text-xs); text-transform: uppercase; letter-spacing: .06em; }
		th, td { padding: var(--sp-3) var(--sp-6) var(--sp-3) 0; border-bottom: 1px solid var(--line); }
		td.path { color: var(--muted); }
		.pill { padding: .05rem var(--sp-5); border-radius: 999px; background: var(--pill); }
		.bar { height: 4px; background: var(--pill); border-radius: 2px; margin: var(--sp-3) 0; overflow: hidden; }
		.bar-hidden { display: none; }
		.bar-fill { height: 100%; background: var(--run); transition: width .3s linear; }
		.state-running .pill, .state-running .status-text { color: var(--run); }
		.state-ready .pill, .state-ready .status-text { color: var(--ok); }
		.state-failed .pill, .state-failed .status-text { color: var(--err); }
		.state-removing .pill, .state-removing .status-text,
		.state-removed .pill, .state-removed .status-text { color: var(--muted); }
		.state-skipped .pill, .state-skipped .status-text { color: var(--warn); }
		/* flex-shrink: 0 - a compact row's flex layout would otherwise
		   squeeze this below its content's width once the row runs out of
		   space, wrapping "rerun" under its icon instead of shrinking the
		   row's other, more flexible content (its name, its message). */
		.rerun-actions { display: inline-flex; flex-shrink: 0; margin-left: var(--sp-4); }
		/* .split-controls (not .split itself) clips the button pair into
		   one rounded pill - .rerun-menu is .split's other child, and an
		   ancestor's "overflow: hidden" would clip its dropdown too, since
		   it's positioned relative to .split. */
		.split { display: inline-flex; position: relative; }
		.split.cascade-only { border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
		.split-controls { display: inline-flex; align-items: stretch; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
		.split-btn {
			border: none; background: none; color: var(--muted); cursor: pointer; font: inherit;
			font-size: var(--text-2xs); padding: var(--sp-1) var(--sp-4); white-space: nowrap;
		}
		.split-btn:hover { color: var(--run); background: var(--pill); }
		.split.cascade-only .split-btn:hover { color: var(--warn); }
		.split-caret {
			border-left: 1px solid var(--line); color: var(--muted); cursor: pointer;
			display: flex; align-items: center; padding: var(--sp-1) var(--sp-3);
		}
		.split-caret:hover { color: var(--fg); background: var(--pill); }
		.rerun-menu-toggle { position: absolute; opacity: 0; pointer-events: none; }
		.rerun-menu {
			display: none; position: absolute; top: 100%; right: 0; margin-top: var(--sp-1); z-index: 1;
			flex-direction: column; min-width: 9rem; background: var(--bg); color: var(--fg);
			border: 1px solid var(--line); border-radius: 6px; padding: var(--sp-2);
		}
		.rerun-menu-toggle:checked ~ .rerun-menu { display: flex; }
		.rerun-menu button {
			border: none; background: none; color: var(--fg); text-align: left; cursor: pointer; font: inherit;
			font-size: var(--text-2xs); padding: var(--sp-2) var(--sp-3); border-radius: 4px;
		}
		.rerun-menu button:hover { background: var(--pill); }
		.rerun-menu button.cascade { color: var(--warn); }
		.kind-resource { color: var(--k-resource); }
		.kind-action { color: var(--warn); }
		.kind-probe { color: var(--k-probe); }
		.badge-idempotent { color: var(--ok); font-size: var(--text-md); margin: 0 var(--sp-3); cursor: default; }
		.badge-cross-scope {
			display: inline-flex; align-items: center; gap: var(--sp-2); flex-shrink: 0; white-space: nowrap;
			color: var(--muted); font-size: var(--text-2xs); border: 1px solid var(--line);
			border-radius: 4px; padding: 0 var(--sp-3); margin: 0 var(--sp-3); cursor: default;
		}
		.scroll { max-height: 22rem; overflow-y: auto; border: 1px solid var(--line);
		          border-radius: 6px; padding: var(--sp-5); }
		.line { display: flex; gap: var(--sp-7); white-space: pre-wrap; word-break: break-word; }
		.line .step { color: var(--muted); min-width: 6rem; }
		/* Only "All" mixes steps, so only there does the name earn its
		   column - a single step's own log panel would repeat the same
		   name on every line, for width the panel needs more now that
		   .log-steps sits beside it. */
		.logpanel:not(#log-all) .line .step { display: none; }
		.stream-stderr .text { color: var(--warn); }
		.status-2 td:first-child { color: var(--ok); }
		.status-4 td:first-child, .status-5 td:first-child { color: var(--err); }
		.direct td { opacity: .65; }
		.denied td { color: var(--err); opacity: 1; }
		a { color: var(--run); }

		/* Layout: a sidebar of steps beside a tabbed main area. */
		.layout { display: flex; align-items: flex-start; gap: var(--sp-9); margin-top: var(--sp-9); }
		#sidebar { flex: 0 0 14rem; position: relative; }
		#sidebar ul { list-style: none; margin: 0 0 0 1.1rem; padding: 0; display: flex; flex-direction: column; gap: var(--sp-5); }
		#sidebar li {
			border: 1px solid var(--line); border-left-width: 3px; border-radius: 6px;
			padding: var(--sp-5) var(--sp-6);
		}
		/* State reads off the card's left edge instead of a second chip next
		   to the kind chip - kind and state both stay real words either way,
		   the color is a bonus cue, never their only carrier. */
		#sidebar li.state-ready:not(.compact) { border-left-color: var(--ok); }
		#sidebar li.state-failed:not(.compact) { border-left-color: var(--err); }
		#sidebar li.state-skipped:not(.compact) { border-left-color: var(--warn); }
		.status-line { font-size: var(--text-xs); }
		.status-line .kind-text {
			text-transform: uppercase; letter-spacing: .05em; font-weight: 600; font-size: var(--text-2xs);
		}
		.status-line .dot { color: var(--muted); margin: 0 .3em; }
		/* Compact: a gate step (probe, route) - one muted line, no card. The
		   left padding matches a bordered card's border + padding-left so a
		   dependency-line's endpoint dot lands beside the text, not on it. */
		#sidebar li.compact {
			border: none; border-radius: 0; padding: var(--sp-1) 0 var(--sp-1) var(--sp-6);
			display: flex; align-items: baseline; gap: var(--sp-4);
			color: var(--muted); font-size: .85em;
		}
		#sidebar li.compact .name { font-weight: 400; }
		/* Step group: a checkbox+label toggle, collapsed by default, no JS
		   needed for the show/hide itself - drawDepLines still runs on
		   toggle since a ":checked" change trips no DOM mutation. A left
		   accent bar and a bold label set it apart from a plain step card -
		   not a background tint, which would sit under the header's own
		   state pill at the same color .pill already uses and hide it. */
		#sidebar li.group { padding: 0; border-left: 3px solid var(--fg); }
		.group-toggle { position: absolute; opacity: 0; pointer-events: none; }
		.group-header { display: flex; align-items: center; gap: var(--sp-4); cursor: pointer; padding: var(--sp-5) var(--sp-6); }
		.group-header-content { display: contents; }
		.group-header .name { font-weight: 700; }
		.disclosure { display: inline-block; color: var(--muted); transition: transform .15s; }
		.group-toggle:checked ~ .group-header .disclosure { transform: rotate(90deg); }
		#sidebar ul.group-members { display: none; margin: 0; padding: 0 var(--sp-6) var(--sp-5) 1.3rem; }
		#sidebar .group-toggle:checked ~ ul.group-members { display: flex; }
		#dep-lines { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
		.dep-edge { fill: none; stroke: var(--muted); stroke-width: 1.5; opacity: .55; }
		#dep-arrow path { fill: var(--muted); }
		/* A running step's outputs aren't there yet - the pulse marks which
		   card to watch, the flowing dashes on its outgoing edges show where
		   those outputs are headed once it finishes. Not on a compact row
		   (a gate step) - StepItem already downplays those, a pulse would
		   fight that. */
		@keyframes step-pulse {
			0%, 100% { box-shadow: 0 0 0 0 var(--run); }
			50% { box-shadow: 0 0 5px 1px var(--run); }
		}
		#sidebar li.state-running:not(.compact) { border-left-color: var(--run); animation: step-pulse 2.8s ease-in-out infinite; }
		@keyframes dep-flow { to { stroke-dashoffset: -16; } }
		.dep-edge-running { stroke-dasharray: 4 4; stroke-width: 2; opacity: 1; animation: dep-flow .6s linear infinite; }
		@media (prefers-reduced-motion: reduce) {
			#sidebar li.state-running, .dep-edge-running { animation: none; }
		}
		#sidebar .name { display: block; font-weight: 600; }
		.plugin-icon { width: 16px; height: 16px; vertical-align: middle; margin-right: var(--sp-3); border-radius: 3px; }
		.plugin-icon-default { display: inline-block; font-size: var(--text-sm); line-height: 16px; }
		#sidebar .msg { display: block; color: var(--muted); font-size: var(--text-sm); margin-top: var(--sp-2); }
		main { flex: 1 1 auto; min-width: 0; }

		/* CSS-only tabs: a hidden radio immediately followed by its panel.
		   Works for a dynamic, per-step set of panels with no per-name rule
		   and no JS, since the selector never names an id. A label isn't a
		   sibling of its own input though (grouped together for layout
		   instead), so ":checked" can't reach it to mark it active - syncActiveLabels
		   in scripts() toggles .active on change instead. */
		.tabbar { display: flex; gap: var(--sp-8); border-bottom: 1px solid var(--line); margin-bottom: var(--sp-5); flex-wrap: wrap; }
		.tabbar label {
			cursor: pointer; padding: var(--sp-3) 0; margin-bottom: -1px;
			color: var(--muted); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: .06em;
			border-bottom: 2px solid transparent;
		}
		.tabbar label.active { color: var(--fg); font-weight: 600; border-bottom-color: var(--run); }
		.tabinput, .logtabinput { position: absolute; opacity: 0; pointer-events: none; }
		.panel, .logpanel { display: none; }
		.tabinput:checked + .panel, .logtabinput:checked + .logpanel { display: block; }

		/* Logs: a scrollable step list beside the log content, instead of a
		   tab row that wraps once there are more steps than fit on one line. */
		.logs-layout { display: flex; gap: var(--sp-5); }
		.log-steps {
			flex: 0 1 auto; width: max-content; min-width: 6rem; max-width: 11rem;
			display: flex; flex-direction: column; gap: 1px;
			max-height: 22rem; overflow-y: auto; border-right: 1px solid var(--line); padding-right: var(--sp-4);
		}
		.log-steps label {
			cursor: pointer; padding: var(--sp-2) var(--sp-3); border-radius: 4px; color: var(--muted);
			font-size: var(--text-xs); display: flex; align-items: center;
			white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
		}
		.log-steps label.active { background: var(--pill); color: var(--fg); font-weight: 600; }
		.log-live-dot { width: .4rem; height: .4rem; border-radius: 999px; background: var(--run); flex: none; margin-right: var(--sp-2); }
		.log-panels { flex: 1 1 auto; min-width: 0; }

		/* Services: a card per step, hidden until it has a route. */
		.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr)); gap: var(--sp-7); }
		.cards .empty { display: none; grid-column: 1 / -1; color: var(--muted); font-size: var(--text-sm); }
		.cards:not(:has(.card.exposed)) .empty { display: block; }
		.card { display: none; border: 1px solid var(--line); border-radius: 8px; padding: var(--sp-7); }
		.card.exposed { display: block; }
		.card h3 { margin: 0 0 var(--sp-4); font-size: .95rem; }
		.card .detail { margin-top: var(--sp-5); color: var(--muted); }
		.card .detail-label {
			display: block; text-transform: uppercase; font-size: var(--text-2xs);
			letter-spacing: .04em; margin-bottom: var(--sp-1);
		}
		.card .detail-value { display: flex; align-items: center; gap: var(--sp-3); min-width: 0; }
		.card .detail-value > a, .card .detail-value > code {
			flex: 1 1 auto; min-width: 0; overflow: hidden;
			white-space: nowrap; text-overflow: ellipsis;
		}
		.copy-btn {
			border: none; background: none; color: var(--muted); cursor: pointer;
			font-size: var(--text-md); line-height: 1; padding: 0 var(--sp-2); flex: none;
		}
		.copy-btn:hover { color: var(--fg); }
		.copy-btn:disabled { color: var(--ok); cursor: default; }
	</style>
}

// scripts holds the page's client-side behavior beyond what htmx covers -
// currently just the copy-to-clipboard button on a card's addresses.
templ scripts() {
	<script>
		function copyAddr(btn) {
			var val = btn.getAttribute('data-copy');
			navigator.clipboard.writeText(val).then(function() {
				var orig = btn.textContent;
				btn.textContent = '✓';
				btn.disabled = true;
				setTimeout(function() {
					btn.textContent = orig;
					btn.disabled = false;
				}, 1000);
			});
		}

		// colorFor picks a color for a step by its position in the sidebar,
		// so every arrow leaving that step reads as the same color wherever
		// it lands. Stepping by the golden angle (~137.5deg) spreads however
		// many steps there are around the whole hue circle with no two
		// adjacent indices landing near each other - unlike hashing the
		// name, which can clash by chance for a small, arbitrary set of
		// names (it did: three short names once landed within a few tens of
		// degrees of each other, all reading as "reddish").
		function colorFor(index) {
			return 'hsl(' + ((index * 137.508) % 360) + ', 70%, 55%)';
		}

		// laneOf assigns each edge the lowest lane number whose last edge
		// already ended above this one's start, so only edges whose y-spans
		// actually overlap end up in different lanes (classic greedy
		// interval-graph coloring, same idea as a calendar laying out
		// overlapping events side by side) - except a lane already carrying
		// the same source stays available regardless of overlap: same
		// source means same color, so several edges fanning out of one step
		// (e.g. a cluster step that a handful of others all need) share one
		// trunk and read as one line splitting, rather than each claiming
		// its own lane just because they all start at the same point.
		function laneOf(edges) {
			var laneEnds = [];
			var laneSources = [];
			edges.sort(function (a, b) { return a.lo - b.lo || a.hi - b.hi; });
			edges.forEach(function (e) {
				var lane = 0;
				while (lane < laneEnds.length && laneEnds[lane] > e.lo + 2 && laneSources[lane] !== e.source) lane++;
				e.lane = lane;
				laneEnds[lane] = Math.max(laneEnds[lane] || 0, e.hi);
				laneSources[lane] = e.source;
			});
			return laneEnds.length;
		}

		// phaseDelay pins a CSS animation to wall-clock time instead of
		// element age: drawDepLines rebuilds every dep-edge <path> from
		// scratch on every call, which would otherwise restart a running
		// edge's flow animation from 0% before it ever completes a cycle.
		// A negative delay of "now mod duration" starts the fresh path at
		// the phase the old one would be at right now. Reads the duration
		// back from el's own computed style, so styles() stays the only
		// place that names it.
		function phaseDelay(el) {
			var ms = parseFloat(getComputedStyle(el).animationDuration) * 1000;
			return (-(Date.now() % ms)) + 'ms';
		}

		// runningEl returns the element that actually carries a step's
		// state-* class: a plain step's own <li>, or - since GroupItem
		// never replaces its outer <li>, only groupHeader's nested span -
		// a group's header content.
		function runningEl(li) {
			return li.classList.contains('group') ? li.querySelector('.group-header-content') : li;
		}

		function drawDepLines() {
			var g = document.getElementById('dep-edges');
			var sidebar = document.getElementById('sidebar');
			var steps = document.getElementById('steps');
			if (!g || !sidebar || !steps) return;
			var sbRect = sidebar.getBoundingClientRect();
			g.innerHTML = '';

			var order = {};
			document.querySelectorAll('#steps li').forEach(function (li, i) {
				order[li.id.slice('step-'.length)] = i;
			});
			var edges = [];
			document.querySelectorAll('#steps li[data-needs]').forEach(function (li) {
				// A collapsed group's members are display:none - getClientRects
				// is empty for one, and its getBoundingClientRect would
				// otherwise measure as a zero-sized box pinned at (0,0),
				// drawing an edge far off in the corner instead of skipping it.
				if (li.getClientRects().length === 0) return;
				var needs = li.getAttribute('data-needs');
				if (!needs) return;
				var tRect = li.getBoundingClientRect();
				var ty = tRect.top - sbRect.top + tRect.height / 2;
				needs.split(',').forEach(function (name) {
					if (!name) return;
					var src = document.getElementById('step-' + name);
					if (!src || src.getClientRects().length === 0) return;
					var sRect = src.getBoundingClientRect();
					var sy = sRect.top - sbRect.top + sRect.height / 2;
					var re = runningEl(src);
					edges.push({
						sy: sy, ty: ty, lo: Math.min(sy, ty), hi: Math.max(sy, ty), source: order[name],
						running: !!(re && re.classList.contains('state-running')),
					});
				});
			});

			var baseDepth = 8, laneGap = 7;
			var laneCount = laneOf(edges);
			var gutter = baseDepth + Math.max(0, laneCount - 1) * laneGap + 8;
			steps.style.marginLeft = gutter + 'px';

			var svgNS = 'http://www.w3.org/2000/svg';
			edges.forEach(function (e) {
				// depth is constant per lane - every edge in lane N sits at
				// the same x, whatever its own span, so a lane reads as one
				// straight track rather than wobbling in from edge to edge.
				var depth = baseDepth + e.lane * laneGap;
				var x = gutter - depth;
				var color = colorFor(e.source);
				var path = document.createElementNS(svgNS, 'path');
				path.setAttribute('class', e.running ? 'dep-edge dep-edge-running' : 'dep-edge');
				path.setAttribute('marker-end', 'url(#dep-arrow)');
				path.style.stroke = color;
				path.setAttribute('d', 'M' + gutter + ',' + e.sy +
					' L' + x + ',' + (e.sy + depth) +
					' L' + x + ',' + (e.ty - depth) +
					' L' + gutter + ',' + e.ty);
				g.appendChild(path);
				if (e.running) {
					// Every call rebuilds every path from scratch, so this one
					// would otherwise restart mid-flow on every redraw too.
					// Appended first: getComputedStyle needs it connected to
					// resolve animation-duration from the stylesheet.
					path.style.animationDelay = phaseDelay(path);
				}
				// A dot at each end anchors the eye on where a line starts
				// and ends, independent of how tangled the routing between
				// them gets - same color as the line itself.
				[e.sy, e.ty].forEach(function (y) {
					var dot = document.createElementNS(svgNS, 'circle');
					dot.setAttribute('class', 'dep-node');
					dot.setAttribute('cx', gutter);
					dot.setAttribute('cy', y);
					dot.setAttribute('r', 3);
					dot.style.fill = color;
					g.appendChild(dot);
				});
			});
		}
		document.addEventListener('DOMContentLoaded', drawDepLines);
		window.addEventListener('resize', drawDepLines);
		document.addEventListener('DOMContentLoaded', function () {
			new MutationObserver(drawDepLines).observe(document.getElementById('steps'), { childList: true, subtree: true });
		});

		// syncActiveLabels marks each radio group's checked input's own
		// label .active - a label isn't a CSS sibling of its input, so
		// ":checked" can't reach it in plain CSS.
		function syncActiveLabels() {
			document.querySelectorAll('input[type=radio]:checked').forEach(function (input) {
				document.getElementsByName(input.name).forEach(function (sibling) {
					var l = document.querySelector('label[for="' + sibling.id + '"]');
					if (l) l.classList.toggle('active', sibling.checked);
				});
			});
		}
		document.addEventListener('change', function (e) {
			if (e.target.matches('input[type=radio]')) syncActiveLabels();
		});
		document.addEventListener('DOMContentLoaded', syncActiveLabels);
	</script>
}

// Snapshot repaints every region. A client receives it as soon as it
// connects, thus a reconnect after a drop is self healing.
templ Snapshot(v View) {
	for _, s := range v.Steps {
		@StepUpdate(s)
	}
	<hx-partial hx-target="#log-all" hx-swap="innerHTML">
		for _, l := range v.Logs {
			@LogLine(l)
		}
	</hx-partial>
	for _, s := range v.Steps {
		<hx-partial hx-target={ "#log-" + s.Name } hx-swap="innerHTML">
			for _, l := range v.StepLogs[s.Name] {
				@LogLine(l)
			}
		</hx-partial>
	}
	<hx-partial hx-target="#traffic" hx-swap="innerHTML">
		for _, r := range v.Requests {
			@TrafficRow(r)
		}
	</hx-partial>
}
